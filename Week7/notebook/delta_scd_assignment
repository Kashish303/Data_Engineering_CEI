   "source": [
    "# Create updated customer records \n",
    "from pyspark.sql.functions import col, when, lit\n",
    "\n",
    "updated_customers = (\n",
    "    delta_clean\n",
    "    .filter(col(\"customer_id\").isin(\n",
    "        \"U1001\",\n",
    "        \"U1005\",\n",
    "        \"U1010\",\n",
    "        \"U1018\",\n",
    "        \"U1022\"\n",
    "    ))\n",
    "\n",
    "    # Customer U1001 moved to Bangalore\n",
    "    .withColumn(\n",
    "        \"city\",\n",
    "        when(col(\"customer_id\") == \"U1001\",\n",
    "             lit(\"Bangalore\"))\n",
    "        .otherwise(col(\"city\"))\n",
    "    )\n",
    "\n",
    "    # Customer U1005 changed email\n",
    "    .withColumn(\n",
    "        \"email\",\n",
    "        when(col(\"customer_id\") == \"U1005\",\n",
    "             lit(\"arjun.mehta_updated@gmail.com\"))\n",
    "        .otherwise(col(\"email\"))\n",
    "    )\n",
    "\n",
    "    # Customer U1010 upgraded loyalty tier\n",
    "    .withColumn(\n",
    "        \"loyalty_tier\",\n",
    "        when(col(\"customer_id\") == \"U1010\",\n",
    "             lit(\"Platinum\"))\n",
    "        .otherwise(col(\"loyalty_tier\"))\n",
    "    )\n",
    "\n",
    "    # Customer U1018 placed more orders\n",
    "    .withColumn(\n",
    "        \"total_orders\",\n",
    "        when(col(\"customer_id\") == \"U1018\",\n",
    "             lit(28))\n",
    "        .otherwise(col(\"total_orders\"))\n",
    "    )\n",
    "\n",
    "    # Customer U1022 became High priority\n",
    "    .withColumn(\n",
    "        \"priority_tier\",\n",
    "        when(col(\"customer_id\") == \"U1022\",\n",
    "             lit(\"High\"))\n",
    "        .otherwise(col(\"priority_tier\"))\n",
    "    )\n",
    ")\n",
    "\n",
    "display(updated_customers)"
   ]
