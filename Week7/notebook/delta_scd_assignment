    "# create update records\n",
    "from pyspark.sql.functions import col, when, lit\n",
    "\n",
    "updated_customers = (\n",
    "    delta_clean\n",
    "    .filter(col(\"customer_id\").isin(\"U1001\", \"U1005\", \"U1010\"))\n",
    "\n",
    "    # Update City\n",
    "    .withColumn(\n",
    "        \"city\",\n",
    "        when(col(\"customer_id\") == \"U1001\", lit(\"Bangalore\"))\n",
    "        .otherwise(col(\"city\"))\n",
    "    )\n",
    "\n",
    "    # Update Email\n",
    "    .withColumn(\n",
    "        \"email\",\n",
    "        when(\n",
    "            col(\"customer_id\") == \"U1005\",\n",
    "            lit(\"arjun.mehta_updated@gmail.com\")\n",
    "        ).otherwise(col(\"email\"))\n",
    "    )\n",
    "\n",
    "    # Update Loyalty Tier\n",
    "    .withColumn(\n",
    "        \"loyalty_tier\",\n",
    "        when(\n",
    "            col(\"customer_id\") == \"U1010\",\n",
    "            lit(\"Platinum\")\n",
    "        ).otherwise(col(\"loyalty_tier\"))\n",
    "    )\n",
    ")\n",
    "\n",
    "display(updated_customers)"
